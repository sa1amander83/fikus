# PostgreSQL — основное хранилище.
# Схема и демо-данные создаются автоматически при первом запуске.

# Строка подключения (рекомендуется):
DATABASE_URL=postgres://fineflower:password@localhost:5432/fineflower

# Альтернатива: вместо DATABASE_URL можно задать стандартные переменные PG*:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=fineflower
# PGPASSWORD=password
# PGDATABASE=fineflower

# Папка supabase/ содержит SQL-схему с RLS на случай переезда на Supabase Cloud.
